# Homelab media stack — environment template.
#
#   cp .env.example .env    then fill in the real values.
#
# The real .env is NEVER committed (§0.3) — it is in .gitignore. This file
# carries placeholders only. All values below are read by docker-compose.yml.

# ---------------------------------------------------------------------------
# Identity (§3.3)
# ---------------------------------------------------------------------------
# Every linuxserver image runs as this uid/gid. LXC 101 is unprivileged, so
# container 1000 maps to host 101000: /srv/data on the Proxmox HOST must be
# chowned 101000:101000 or the bind mount shows up as nobody:nogroup inside
# and the Phase 4 hardlink gate fails in confusing ways.
PUID=1000
PGID=1000
TZ=Asia/Kuala_Lumpur

# ---------------------------------------------------------------------------
# Paths (§3.1, §3.2)
# ---------------------------------------------------------------------------
# CONFIG_ROOT — stateful, on the NVMe, backed up nightly (§8).
# DATA_ROOT   — the single ext4 filesystem on /dev/sda. torrents/ and media/
#               MUST live under this one path or hardlinks are impossible (C4).
CONFIG_ROOT=/srv/config
DATA_ROOT=/srv/data

# ---------------------------------------------------------------------------
# Ingress mode — the one-line switch
# ---------------------------------------------------------------------------
# ./caddy/Caddyfile.lan  LAN mode, plain HTTP on :80  (active default)
# ./caddy/Caddyfile      tailnet mode, TLS from tailscaled (§5.2) — also
#                        uncomment the tailscaled socket mount in compose
CADDYFILE=./caddy/Caddyfile.lan

# Tailnet name WITHOUT the .ts.net suffix, e.g. tail1a2b3c.
# Unused in LAN mode; needed for the §5.2 phase. Also substitute it into
# caddy/Caddyfile, which ships with a <tailnet> placeholder.
TAILNET=your-tailnet-name

# Base URL baked into every stream URL the addon returns. It must be reachable
# from the Stremio CLIENT, not from inside the container. No trailing slash.
#   LAN mode:     http://192.168.1.50          (this LXC's LAN IP)
#   Tailnet mode: https://media.your-tailnet-name.ts.net
PUBLIC_BASE_URL=http://192.168.1.50

# ---------------------------------------------------------------------------
# Secrets — replace every value below
# ---------------------------------------------------------------------------
# *arr API keys: Settings → General → API Key in each web UI.
RADARR_API_KEY=replace-with-radarr-api-key
SONARR_API_KEY=replace-with-sonarr-api-key

# Bearer token for POST /admin/rescan (§6.5). Generate one:
#   openssl rand -hex 32
ADDON_ADMIN_TOKEN=replace-with-a-long-random-token
